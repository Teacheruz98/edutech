app.get('/api/courses/:id/discussions/general', authMiddleware, async (req, res) => {
    try {
        const messages = await CourseDiscussion.find({
            courseId: req.params.id,
            type: 'general'
        })
        .populate('sender', 'username email role')
        .populate('pinnedBy', 'username role')
        .sort({ createdAt: 1 })
        .lean();

        res.json(messages || []);
    } catch (error) {
        console.error("GET general discussions error:", error);
        res.status(500).json({ message: "Muhokamalarni yuklashda xatolik: " + error.message });
    }
});

// 2. POST General Course Discussion Message
app.post('/api/courses/:id/discussions/general', authMiddleware, async (req, res) => {
    try {
        const { message } = req.body;
        if (!message || !message.trim()) {
            return res.status(400).json({ message: "Xabar matni bo'sh bo'lishi mumkin emas" });
        }

        const newMsg = new CourseDiscussion({
            courseId: req.params.id,
            type: 'general',
            sender: req.user.userId,
            message: message.trim()
        });

        await newMsg.save();
        const populated = await CourseDiscussion.findById(newMsg._id)
            .populate('sender', 'username email role')
            .lean();

        res.status(201).json(populated);
    } catch (error) {
        console.error("POST general discussion error:", error);
        res.status(500).json({ message: "Xabar yuborishda xatolik: " + error.message });
    }
});

// 3. GET Individual 1-on-1 Discussion (Teacher ↔ Student)
app.get('/api/courses/:id/discussions/individual', authMiddleware, async (req, res) => {
    try {
        let studentId = req.query.studentId;

        // Security check:
        // A student can ONLY query their own thread!
        if (req.user.role === 'student') {
            studentId = req.user.userId;
        }

        if (!studentId) {
            return res.status(400).json({ message: "O'quvchi tanlanmadi (studentId talab qilinadi)" });
        }

        const messages = await CourseDiscussion.find({
            courseId: req.params.id,
            type: 'individual',
            studentId
        })
        .populate('sender', 'username email role')
        .populate('recipient', 'username email role')
        .sort({ createdAt: 1 })
        .lean();

        res.json(messages || []);
    } catch (error) {
        console.error("GET individual discussion error:", error);
        res.status(500).json({ message: "Shaxsiy suhbatni yuklashda xatolik: " + error.message });
    }
});

// 4. POST Individual 1-on-1 Discussion Message
app.post('/api/courses/:id/discussions/individual', authMiddleware, async (req, res) => {
    try {
        const { message } = req.body;
        if (!message || !message.trim()) {
            return res.status(400).json({ message: "Xabar matni bo'sh bo'lishi mumkin emas" });
        }

        const course = await Course.findById(req.params.id);
        if (!course) {
            return res.status(404).json({ message: "Kurs topilmadi" });
        }

        let studentId = null;
        let recipientId = null;

        if (req.user.role === 'student') {
            studentId = req.user.userId;
            recipientId = course.instructor;
        } else {
            // Teacher or Admin sending to student
            studentId = req.body.studentId;
            if (!studentId) {
                return res.status(400).json({ message: "O'quvchi tanlanmadi (studentId kiritilishi shart)" });
            }
            recipientId = studentId;
        }

        const newMsg = new CourseDiscussion({
            courseId: req.params.id,
            type: 'individual',
            sender: req.user.userId,
            recipient: recipientId,
            studentId,
            message: message.trim()
        });

        await newMsg.save();
        const populated = await CourseDiscussion.findById(newMsg._id)
            .populate('sender', 'username email role')
            .populate('recipient', 'username email role')
            .lean();

        res.status(201).json(populated);
    } catch (error) {
        console.error("POST individual discussion error:", error);
        res.status(500).json({ message: "Shaxsiy xabar yuborishda xatolik: " + error.message });
    }
});

// 5. GET Course Discussion Participants & Thread Counts (For Teacher/Admin)
app.get('/api/courses/:id/discussions/participants', authMiddleware, async (req, res) => {
    try {
        const course = await Course.findById(req.params.id)
            .populate('instructor', 'username email role')
            .populate('students', 'username email role')
            .lean();

        if (!course) {
            return res.status(404).json({ message: "Kurs topilmadi" });
        }

        const students = course.students || [];

        // Count individual messages per student for this course
        const studentStats = await Promise.all(students.map(async (st) => {
            const msgCount = await CourseDiscussion.countDocuments({
                courseId: course._id,
                type: 'individual',
                studentId: st._id
            });
            const lastMsg = await CourseDiscussion.findOne({
                courseId: course._id,
                type: 'individual',
                studentId: st._id
            }).sort({ createdAt: -1 }).select('message createdAt sender').lean();

            return {
                ...st,
                messageCount: msgCount,
                lastMessage: lastMsg
            };
        }));

        res.json({
            instructor: course.instructor,
            students: studentStats
        });
    } catch (error) {
        console.error("GET discussion participants error:", error);
        res.status(500).json({ message: "Ishtirokchilarni yuklashda xatolik" });
    }
});

// 6. DELETE Discussion Message (Admin, Teacher, or Message Author)
app.delete('/api/courses/:id/discussions/:messageId', authMiddleware, async (req, res) => {
    try {
        const msg = await CourseDiscussion.findById(req.params.messageId);
        if (!msg) {
            return res.status(404).json({ message: "Xabar topilmadi" });
        }

        const course = await Course.findById(msg.courseId);
        const isInstructor = course && String(course.instructor) === String(req.user.userId);
        const isAdmin = req.user.role === 'admin';
        const isAuthor = String(msg.sender) === String(req.user.userId);

        if (!isAdmin && !isInstructor && !isAuthor) {
            return res.status(403).json({ message: "Ushbu xabarni o'chirishga vakolatingiz yo'q" });
        }

        await CourseDiscussion.findByIdAndDelete(req.params.messageId);
        res.json({ success: true, message: "Xabar muvaffaqiyatli o'chirildi" });
    } catch (error) {
        console.error("DELETE discussion message error:", error);
        res.status(500).json({ message: "Xabarni o'chirishda xatolik: " + error.message });
    }
});

// 7. PIN / UNPIN Discussion Message (Admin or Teacher)
app.patch('/api/courses/:id/discussions/:messageId/pin', authMiddleware, async (req, res) => {
    try {
        const msg = await CourseDiscussion.findById(req.params.messageId);
        if (!msg) {
            return res.status(404).json({ message: "Xabar topilmadi" });
        }

        const course = await Course.findById(msg.courseId);
        const isInstructor = course && String(course.instructor) === String(req.user.userId);
        const isAdmin = req.user.role === 'admin';

        if (!isAdmin && !isInstructor) {
            return res.status(403).json({ message: "Xabarni qadash faqat o'qituvchi yoki admin uchun mumkin" });
        }

        msg.isPinned = !msg.isPinned;
        msg.pinnedBy = msg.isPinned ? req.user.userId : null;
        msg.pinnedAt = msg.isPinned ? new Date() : null;
        await msg.save();

        const populated = await CourseDiscussion.findById(msg._id)
            .populate('sender', 'username email role')
            .populate('pinnedBy', 'username role')
            .lean();

        res.json(populated);
    } catch (error) {
        console.error("PIN discussion message error:", error);
        res.status(500).json({ message: "Xabarni qadashda xatolik: " + error.message });
    }
});

