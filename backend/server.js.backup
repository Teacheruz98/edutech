# Python dasturlash tili bo'yicha namunaviy yechim
def process_data(data_list):
    """
    Kiritilgan ma'lumotlarni tahlil qilish va saralash funksiyasi
    """
    processed = [x * 2 for x in data_list if isinstance(x, (int, float))]
    return {
        "original_count": len(data_list),
        "processed_values": processed,
        "total_sum": sum(processed)
    }

# Sinov:
sample_input = [1, 5, 10, 15, 20]
