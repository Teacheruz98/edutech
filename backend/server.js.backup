// =============================================
// SEMESTER & CAMBRIDGE HELPER FUNCTIONS
// =============================================

const getCurrentSemester = (date = new Date()) => {
    const month = date.getMonth() + 1; // 1-12
    if (month >= 9 && month <= 12) return 'Semester 1';
    if (month >= 1 && month <= 6) return 'Semester 2';
    return 'Semester 1'; // July-August default to Semester 1
};

const getCambridgeGrade = (percentage, gradeLevel = '5-7') => {
    if (percentage === null || percentage === undefined || isNaN(percentage) || percentage <= 0) {
        return { score: '-', grade: 'Baho yo\'q', label: 'Ungraded', level: 'Ungraded', color: '#64748b', description: 'Baho qo\'yilmagan' };
    }
    const num = Math.round(Number(percentage));

    if (gradeLevel === '8-11') {
        // Grades 8 - 11 Scale
        if (num >= 85) return { score: '5', grade: '5', label: '5 - Excellent (Mastery)', level: 'Excellent (Mastery)', color: '#10b981', description: 'Excellent (Mastery) [85-100%]' };
        if (num >= 75) return { score: '4', grade: '4', label: '4 - Good (Approaching Mastery)', level: 'Good (Approaching Mastery)', color: '#3b82f6', description: 'Good (Approaching Mastery) [75-84%]' };
        if (num >= 60) return { score: '3', grade: '3', label: '3 - Satisfactory (Developing)', level: 'Satisfactory (Developing)', color: '#f59e0b', description: 'Satisfactory (Developing) [60-74%]' };
        if (num >= 45) return { score: '2', grade: '2', label: '2 - Unsatisfactory (Beginning)', level: 'Unsatisfactory (Beginning)', color: '#ec4899', description: 'Unsatisfactory (Beginning) [45-59%]' };
        return { score: '1', grade: '1', label: '1 - Fail', level: 'Fail', color: '#ef4444', description: 'Fail [1-44%]' };
    } else {
        // Grades 5 - 7 Scale (Default)
        if (num >= 80) return { score: '5', grade: '5', label: '5 - Excellent (Mastery)', level: 'Excellent (Mastery)', color: '#10b981', description: 'Excellent (Mastery) [80-100%]' };
        if (num >= 70) return { score: '4', grade: '4', label: '4 - Good (Approaching Mastery)', level: 'Good (Approaching Mastery)', color: '#3b82f6', description: 'Good (Approaching Mastery) [70-79%]' };
        if (num >= 55) return { score: '3', grade: '3', label: '3 - Satisfactory (Developing)', level: 'Satisfactory (Developing)', color: '#f59e0b', description: 'Satisfactory (Developing) [55-69%]' };
        if (num >= 45) return { score: '2', grade: '2', label: '2 - Unsatisfactory (Beginning)', level: 'Unsatisfactory (Beginning)', color: '#ec4899', description: 'Unsatisfactory (Beginning) [45-54%]' };
        return { score: '1', grade: '1', label: '1 - Fail', level: 'Fail', color: '#ef4444', description: 'Fail [1-44%]' };
    }
};

const checkSemesterLock = async (semester, courseId, reqUser) => {
    if (reqUser.role === 'admin') {
        return { isLocked: false, reason: 'admin' };
    }

    const now = new Date();
    const currentYear = now.getFullYear();
    let isPastDeadline = false;

    // Check semester deadline
    if (semester === 'Semester 1') {
        // Semester 1 cutoff: Dec 31 of current year
        const deadlineSem1 = new Date(currentYear, 11, 31, 23, 59, 59);
        if (now > deadlineSem1 && now.getMonth() >= 0 && now.getMonth() <= 5) {
            isPastDeadline = true; // In Semester 2 trying to edit Semester 1
        }
    } else if (semester === 'Semester 2') {
        // Semester 2 cutoff: June 30 of current year
        const deadlineSem2 = new Date(currentYear, 5, 30, 23, 59, 59);
        if (now > deadlineSem2 && now.getMonth() >= 6) {
            isPastDeadline = true; // Past June 30
        }
    }

    // Check active approved unlock request
    const activeRequest = await GradeUnlockRequest.findOne({
        courseId,
        semester,
        teacherId: reqUser.userId,
        status: 'approved',
        approvedUntil: { $gt: now }
    }).sort({ approvedUntil: -1 });

    if (activeRequest) {
        return { isLocked: false, reason: 'unlocked_by_admin', activeRequest };
    }

    if (isPastDeadline) {
        const pendingRequest = await GradeUnlockRequest.findOne({
            courseId,
            semester,
            teacherId: reqUser.userId
        }).sort({ createdAt: -1 });

        return { isLocked: true, reason: 'deadline_passed', activeRequest: pendingRequest };
    }

    return { isLocked: false, reason: 'within_semester' };
};

