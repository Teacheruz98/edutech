// Save Custom AI Keys (Universal Provider Support)
app.post('/api/admin/ai-key', authMiddleware, adminOnly, async (req, res) => {
    try {
        const { openRouterKey, geminiKey, genericKey, genericEndpoint, genericModel } = req.body;
        if (openRouterKey !== undefined) {
            await SystemSetting.findOneAndUpdate(
                { key: 'custom_openrouter_api_key' },
                { value: openRouterKey.trim(), updatedBy: req.user.username, updatedAt: new Date() },
                { upsert: true }
            );
        }
        if (geminiKey !== undefined) {
            await SystemSetting.findOneAndUpdate(
                { key: 'custom_gemini_api_key' },
                { value: geminiKey.trim(), updatedBy: req.user.username, updatedAt: new Date() },
                { upsert: true }
            );
        }
        if (genericKey !== undefined) {
            await SystemSetting.findOneAndUpdate(
                { key: 'custom_generic_api_key' },
                { value: genericKey.trim(), updatedBy: req.user.username, updatedAt: new Date() },
                { upsert: true }
            );
        }
        if (genericEndpoint !== undefined) {
            await SystemSetting.findOneAndUpdate(
                { key: 'custom_generic_endpoint' },
                { value: genericEndpoint.trim(), updatedBy: req.user.username, updatedAt: new Date() },
                { upsert: true }
            );
        }
        if (genericModel !== undefined) {
            await SystemSetting.findOneAndUpdate(
                { key: 'custom_generic_model' },
                { value: genericModel.trim(), updatedBy: req.user.username, updatedAt: new Date() },
                { upsert: true }
            );
        }
        res.json({ message: "AI API Kalitlari va Router sozlamalari muvaffaqiyatli saqlandi! 🔑" });
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

