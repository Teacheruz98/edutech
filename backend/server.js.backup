# Rekursiya va Rekursiv bo'lmagan usullar
def factorial(n):
    if n < 0:
        return "Manfiy sonlar uchun faktorial mavjud emas"
    if n == 0 or n == 1:
        return 1
    return n * factorial(n - 1)

# Sinov:
number = 5
print(f"{number}! = {factorial(number)}")
# Natija: 5! = 120
\`\`\`

