app.get('/api/courses/:id/students', authMiddleware, async (req, res) => {
    try {
        const course = await Course.findById(req.params.id).populate('students', 'username email role');
        if (!course) return res.status(404).json({ message: "Kurs topilmadi" });
        
        let students = course.students || [];
        // Only auto-populate default students IF course has never been initialized before AND caller is teacher/admin
        if (!course.isInitialized && students.length === 0 && (req.user.role === 'teacher' || req.user.role === 'admin')) {
            students = await User.find({ role: 'student', isApproved: true }).select('username email role');
            course.students = students.map(s => s._id);
            course.isInitialized = true;
            await course.save();
        }
        res.json(students);
    } catch (error) { 
        console.error("GET course students error:", error);
        res.status(500).json({ message: "Xatolik" }); 
    }
});

app.post('/api/courses/:id/add-student', authMiddleware, teacherOrAdmin, async (req, res) => {
    try {
        const { email } = req.body;
        if (!email) return res.status(400).json({ message: "Email yoki foydalanuvchi nomini kiritishingiz shart" });
        
        const cleanInput = email.trim();
        const safeRegex = new RegExp('^' + cleanInput.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + '$', 'i');
        const student = await User.findOne({
            $or: [
                { email: safeRegex },
                { username: safeRegex }
            ]
        });
        
        if (!student) {
            return res.status(404).json({ message: `"${cleanInput}" bo'yicha foydalanuvchi topilmadi` });
        }
        
        if (student.role !== 'student') {
            return res.status(400).json({ message: `"${student.username}" foydalanuvchisi o'quvchi (student) emas` });
        }

        const course = await Course.findById(req.params.id);
        if (!course) return res.status(404).json({ message: "Kurs topilmadi" });

        const isAlreadyEnrolled = (course.students || []).some(sId => sId.toString() === student._id.toString());
        if (isAlreadyEnrolled) {
            return res.status(400).json({ message: `O'quvchi (${student.username}) allaqachon ushbu kursga qo'shilgan` });
        }

        if (!course.students) course.students = [];
        course.students.push(student._id);
        course.isInitialized = true;
        await course.save();

        res.json({
            message: `O'quvchi (@${student.username} - ${student.email}) kursga muvaffaqiyatli qo'shildi! 🎉`,
            student: { _id: student._id, username: student.username, email: student.email }
        });
    } catch (error) {
        console.error("Add student error:", error);
        res.status(500).json({ message: "O'quvchini qo'shishda xatolik" });
    }
});

app.delete('/api/courses/:id/remove-student/:studentId', authMiddleware, teacherOrAdmin, async (req, res) => {
    try {
        const course = await Course.findById(req.params.id);
        if (!course) return res.status(404).json({ message: "Kurs topilmadi" });

        course.students = (course.students || []).filter(sId => sId.toString() !== req.params.studentId.toString());
        course.isInitialized = true;
        await course.save();

        res.json({ message: "O'quvchi kursdan olib tashlandi" });
    } catch (error) {
        console.error("Remove student error:", error);
        res.status(500).json({ message: "O'quvchini olib tashlashda xatolik" });
    }
});

