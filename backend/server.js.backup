// Import and parse questions from .DOCX Word file
app.post('/api/courses/:courseId/question-maker/import-docx', authMiddleware, teacherOrAdmin, uploadDocx.single('file'), async (req, res) => {
    try {
        if (!req.file || !req.file.buffer) {
            return res.status(400).json({ message: ".DOCX fayli yuklanmadi!" });
        }

        const result = await mammoth.extractRawText({ buffer: req.file.buffer });
        const rawText = result.value || '';
        
        if (!rawText.trim()) {
            return res.status(400).json({ message: ".DOCX fayli bo'sh yoki matn o'qilmadi!" });
        }

        const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
        const parsedQuestions = [];
        let currentQuestion = null;

        const questionPrefixRegex = /^(\d+[\.\-\)]\s*|savol\s*\d*[\.\:\-\)]\s*)/i;
        const optionPrefixRegex = /^([a-hA-H][\.\)]\s*|[\-\*•]\s*)/i;

        lines.forEach((line) => {
            const isOpt = optionPrefixRegex.test(line);
            const isQLine = !isOpt && (questionPrefixRegex.test(line) || line.endsWith('?') || !currentQuestion || currentQuestion.options.length >= 2);

            if (isQLine) {
                if (currentQuestion && currentQuestion.questionText && currentQuestion.options.length > 0) {
                    parsedQuestions.push(currentQuestion);
                }
                const cleanedQText = line.replace(/^(\d+[\.\-\)]\s*|savol\s*\d*[\.\:\-\)]\s*)/i, '').trim();
                currentQuestion = {
                    questionText: cleanedQText || line,
                    options: [],
                    correctIndex: 0
                };
            } else if (currentQuestion) {
                let isCorrect = false;
                let optText = line;

                if (optText.endsWith('*')) {
                    isCorrect = true;
                    optText = optText.slice(0, -1);
                } else if (optText.startsWith('*')) {
                    isCorrect = true;
                    optText = optText.slice(1);
                }

                optText = optText.replace(/^([a-hA-H][\.\)]\s*|[\-\*•]\s*)/i, '').trim();
                if (optText.endsWith('*')) {
                    isCorrect = true;
                    optText = optText.slice(0, -1).trim();
                }

                if (optText) {
                    if (isCorrect) {
                        currentQuestion.correctIndex = currentQuestion.options.length;
                    }
                    currentQuestion.options.push(optText);
                }
            }
        });

        if (currentQuestion && currentQuestion.questionText && currentQuestion.options.length > 0) {
            parsedQuestions.push(currentQuestion);
        }

        if (parsedQuestions.length === 0) {
            return res.status(400).json({ message: "Fayldan savollar topilmadi. Savollar raqamlangan bo'lishi va variantlar A), B), C) shaklida bo'lishi kerak." });
        }

        // Generate suggested title from filename or first line
        const fileName = req.file.originalname ? req.file.originalname.replace(/\.[^/.]+$/, "") : "Docx Test";

        res.json({
            suggestedTitle: fileName,
            questions: parsedQuestions
        });
    } catch (error) {
        console.error("Parse docx error:", error);
        res.status(500).json({ message: ".DOCX faylini o'qishda xatolik yuz berdi" });
    }
});

// Create a new QuestionMaker quiz (Teacher / Admin)
app.post('/api/courses/:courseId/question-maker', authMiddleware, teacherOrAdmin, async (req, res) => {
    try {
        const { title, authorName, timeLimit, questions } = req.body;
        if (!title || !questions || !Array.isArray(questions) || questions.length === 0) {
            return res.status(400).json({ message: "Kamida bitta savol va sarlavha kiritilishi shart!" });
        }

        // Process questions and clean asterisk (*) option markers
        const processedQuestions = questions.map(q => {
            let correctIdx = typeof q.correctIndex === 'number' ? q.correctIndex : 0;
            const cleanedOptions = (q.options || []).map((opt, idx) => {
                let str = String(opt || '').trim();
                // Check if option contains asterisk (*) indicating correct answer
                if (str.endsWith('*')) {
                    correctIdx = idx;
                    str = str.slice(0, -1).trim();
                } else if (str.startsWith('*')) {
                    correctIdx = idx;
                    str = str.slice(1).trim();
                }
                return str;
            });

            return {
                questionText: q.questionText || q.question || 'Savol matni',
                options: cleanedOptions,
                correctIndex: correctIdx
            };
        });

        const newQuiz = new QuestionMaker({
            courseId: req.params.courseId,
            title: title.trim(),
            authorName: authorName || req.user.username || 'O\'qituvchi',
            timeLimit: Number(timeLimit) || 15,
            questions: processedQuestions
        });

        await newQuiz.save();
        res.status(201).json(newQuiz);
    } catch (error) {
        console.error("Create QuestionMaker quiz error:", error);
        res.status(500).json({ message: "Savol to'plamini saqlashda xatolik" });
    }
});

// Delete a QuestionMaker quiz
app.delete('/api/question-maker/:id', authMiddleware, teacherOrAdmin, async (req, res) => {
    try {
        await QuestionMaker.findByIdAndDelete(req.params.id);
        await QuestionResult.deleteMany({ quizId: req.params.id });
        res.json({ message: "Test va uning natijalari o'chirildi" });
    } catch (error) {
        console.error("Delete QuestionMaker quiz error:", error);
        res.status(500).json({ message: "Testni o'chirishda xatolik" });
    }
});

// Submit quiz answers (Student)
app.post('/api/question-maker/:id/submit', authMiddleware, async (req, res) => {
    try {
        const { answers, timeSpentSeconds } = req.body; // array of selected option indexes
        const quiz = await QuestionMaker.findById(req.params.id);
        if (!quiz) {
            return res.status(404).json({ message: "Test topilmadi" });
        }

        const user = await User.findById(req.user.userId);
        const studentName = user ? user.username : 'O\'quvchi';
        const studentEmail = user ? user.email : '';

        let correctCount = 0;
        const totalQuestions = quiz.questions.length;

        quiz.questions.forEach((q, idx) => {
            if (answers && answers[idx] !== undefined && Number(answers[idx]) === q.correctIndex) {
                correctCount++;
            }
        });

        const scorePercentage = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;

        // Upsert result for student
        const result = await QuestionResult.findOneAndUpdate(
            { quizId: quiz._id, studentId: req.user.userId },
            {
                quizId: quiz._id,
                courseId: quiz.courseId,
                studentId: req.user.userId,
                studentName,
                studentEmail,
                answers: answers || [],
                scorePercentage,
                correctCount,
                totalQuestions,
                timeSpentSeconds: Number(timeSpentSeconds) || 0,
                submittedAt: new Date()
            },
            { upsert: true, new: true }
        );

        res.json({
            message: "Test muvaffaqiyatli topshirildi",
            result
        });
    } catch (error) {
        console.error("Submit QuestionMaker quiz error:", error);
        res.status(500).json({ message: "Test natijasini saqlashda xatolik" });
    }
});

// Get live real-time results for a quiz
app.get('/api/question-maker/:id/results', authMiddleware, async (req, res) => {
    try {
        const results = await QuestionResult.find({ quizId: req.params.id }).sort({ scorePercentage: -1, submittedAt: 1 });
        res.json(results);
    } catch (error) {
        console.error("Get QuestionMaker results error:", error);
        res.status(500).json({ message: "Natijalarni olishda xatolik" });
    }
});

// =============================================
// GLOBAL SYSTEM SETTINGS API (Real-time Season Sync)
// =============================================

const SystemSettingSchema = new mongoose.Schema({
    key: { type: String, required: true, unique: true },
    value: { type: mongoose.Schema.Types.Mixed, required: true },
    updatedBy: String,
    updatedAt: { type: Date, default: Date.now }
});
const SystemSetting = mongoose.models.SystemSetting || mongoose.model('SystemSetting', SystemSettingSchema);

let cachedSeasonValue = null;
let lastSeasonCachedAt = 0;

app.get('/api/settings/season', async (req, res) => {
    try {
        const now = Date.now();
        if (cachedSeasonValue && (now - lastSeasonCachedAt < 15000)) {
            return res.json({ season: cachedSeasonValue });
        }
        let setting = await SystemSetting.findOne({ key: 'season' }).lean();
        if (!setting) {
            setting = await SystemSetting.create({ key: 'season', value: 'off' });
        }
        cachedSeasonValue = setting.value || 'off';
        lastSeasonCachedAt = now;
        res.json({ season: cachedSeasonValue });
    } catch (err) {
        res.json({ season: cachedSeasonValue || 'off' });
    }
});

app.post('/api/settings/season', authMiddleware, adminOnly, async (req, res) => {
    try {
        const { season } = req.body;
        const validSeasons = ['off', 'spring', 'summer', 'autumn', 'winter'];
        if (!validSeasons.includes(season)) {
            return res.status(400).json({ message: "Noto'g'ri fasl kiritildi" });
        }
        let setting = await SystemSetting.findOneAndUpdate(
            { key: 'season' },
            { value: season, updatedBy: req.user.username, updatedAt: new Date() },
            { upsert: true, new: true }
        );
        cachedSeasonValue = season;
        lastSeasonCachedAt = Date.now();
        res.json({ message: "Fasl rejimi muvaffaqiyatli sinxronlashtirildi", season: setting.value });
    } catch (err) {
        res.status(500).json({ message: "Xatolik yuz berdi" });
    }
});

// =============================================
// EXECUTIVE MANAGEMENT CONTROL & AUDIT APIS
// =============================================

// 1. Executive Platform Statistics & Grade Distribution
app.get('/api/management/stats', authMiddleware, managementOrAdmin, async (req, res) => {
    try {
        const [totalStudents, totalTeachers, totalCourses, grades, auditsCount] = await Promise.all([
            User.countDocuments({ role: 'student' }),
            User.countDocuments({ role: 'teacher' }),
            Course.countDocuments(),
            Grade.find(),
            ManagementAudit.countDocuments()
        ]);

        const totalGrades = grades.length;
        const totalPercentageSum = grades.reduce((acc, g) => acc + (g.percentage || g.score || 0), 0);
        const averageScore = totalGrades > 0 ? (totalPercentageSum / totalGrades).toFixed(1) : 0;

        // Cambridge Grade Distribution
        const gradeDistribution = { 'A*': 0, 'A': 0, 'B': 0, 'C': 0, 'D': 0, 'E': 0, 'U': 0 };
        grades.forEach(g => {
            const letter = (g.grade || '').trim().toUpperCase();
            if (gradeDistribution[letter] !== undefined) {
                gradeDistribution[letter]++;
            } else if (letter) {
                gradeDistribution['U']++;
            }
        });

        res.json({
            totalStudents,
            totalTeachers,
            totalCourses,
            totalGrades,
            averageScore,
            gradeDistribution,
            auditsCount
        });
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 2. Comprehensive Grades Inspection & Export API
app.get('/api/management/grades', authMiddleware, managementOrAdmin, async (req, res) => {
    try {
        const { search, classGroup } = req.query;
        let filter = {};

        const grades = await Grade.find(filter)
            .populate('studentId', 'username email grade')
            .populate('courseId', 'title code')
            .populate('teacherId', 'username')
            .sort({ date: -1 });

        let formatted = grades.map(g => ({
            _id: g._id,
            studentUsername: g.studentId?.username || 'O\'quvchi',
            studentEmail: g.studentId?.email || '-',
            classGroup: g.studentId?.grade || '5-sinf',
            courseTitle: g.courseId?.title || 'Umumiy Fan',
            teacherUsername: g.teacherId?.username || 'O\'qituvchi',
            assessmentType: g.type || 'BSB',
            score: g.score || 0,
            percentage: g.percentage || g.score || 0,
            cambridgeGrade: g.grade || 'A',
            feedback: g.comment || g.feedback || 'Yaxshi',
            date: g.date || g.createdAt
        }));

        if (search) {
            const q = search.toLowerCase();
            formatted = formatted.filter(g => 
                g.studentUsername.toLowerCase().includes(q) || 
                g.courseTitle.toLowerCase().includes(q) || 
                g.teacherUsername.toLowerCase().includes(q)
            );
        }

        if (classGroup && classGroup !== 'Barchasi') {
            formatted = formatted.filter(g => g.classGroup === classGroup);
        }

        res.json(formatted);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 3. Get All Executive Audit Summaries (Teachers, Management & Admins, excluded for Students)
app.get('/api/management/audits', authMiddleware, async (req, res) => {
    try {
        if (req.user.role === 'student') {
            return res.status(403).json({ message: "O'quvchilar uchun ruxsat berilmagan" });
        }
        const audits = await ManagementAudit.find().sort({ createdAt: -1 });
        res.json(audits);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 4. Create Executive Audit Summary / Inspection Note
app.post('/api/management/audit-note', authMiddleware, managementOrAdmin, async (req, res) => {
    try {
        const { targetCourseTitle, classGroup, auditCategory, summaryTitle, executiveNote, recommendations, overallRating } = req.body;
        if (!summaryTitle || !executiveNote) {
            return res.status(400).json({ message: "Xulosa sarlavhasi va matnini kiriting!" });
        }

        const newAudit = new ManagementAudit({
            authorId: req.user.userId,
            authorUsername: req.user.username,
            targetCourseTitle: targetCourseTitle || 'Umumiy Platforma Audit',
            classGroup: classGroup || 'Barchasi',
            auditCategory: auditCategory || 'Baholash Nazorati',
            summaryTitle,
            executiveNote,
            recommendations: recommendations || '',
            overallRating: Number(overallRating) || 5
        });

        await newAudit.save();
        res.status(201).json({ message: "Umumiy xulosa va tekshiruv dalolatnomasi muvaffaqiyatli saqlandi! 📝", audit: newAudit });
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 5. Delete Executive Audit Summary
app.delete('/api/management/audit-note/:id', authMiddleware, managementOrAdmin, async (req, res) => {
    try {
        await ManagementAudit.findByIdAndDelete(req.params.id);
        res.json({ message: "Xulosa o'chirildi" });
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 6. Toggle Emoji Reaction on Audit Note
app.post('/api/management/audits/:id/reaction', authMiddleware, async (req, res) => {
    try {
        if (req.user.role === 'student') {
            return res.status(403).json({ message: "O'quvchilar uchun ruxsat berilmagan" });
        }
        const { emoji } = req.body;
        if (!emoji) return res.status(400).json({ message: "Emoji ko'rsatilmadi" });

        const audit = await ManagementAudit.findById(req.params.id);
        if (!audit) return res.status(404).json({ message: "Audit xulosasi topilmadi" });

        if (!audit.reactions) audit.reactions = [];
        const existingIdx = audit.reactions.findIndex(r => r.userId?.toString() === req.user.userId && r.emoji === emoji);

        if (existingIdx > -1) {
            audit.reactions.splice(existingIdx, 1);
        } else {
            audit.reactions.push({
                userId: req.user.userId,
                username: req.user.username,
                emoji,
                createdAt: new Date()
            });
        }

        await audit.save();
        res.json(audit);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 7. Delete Emoji Reaction (Admin or Owner)
app.delete('/api/management/audits/:id/reaction/:reactionId', authMiddleware, async (req, res) => {
    try {
        const audit = await ManagementAudit.findById(req.params.id);
        if (!audit) return res.status(404).json({ message: "Audit xulosasi topilmadi" });

        const reaction = audit.reactions.id(req.params.reactionId);
        if (!reaction) return res.status(404).json({ message: "Reaksiya topilmadi" });

        if (req.user.role !== 'admin' && reaction.userId?.toString() !== req.user.userId) {
            return res.status(403).json({ message: "Faqat admin yoki reaksiya muallifi olib tashlashi mumkin" });
        }

        audit.reactions.pull(req.params.reactionId);
        await audit.save();
        res.json(audit);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 8. Add Comment to Audit Note
app.post('/api/management/audits/:id/comment', authMiddleware, async (req, res) => {
    try {
        if (req.user.role === 'student') {
            return res.status(403).json({ message: "O'quvchilar uchun ruxsat berilmagan" });
        }
        const { text } = req.body;
        if (!text || !text.trim()) return res.status(400).json({ message: "Izoh matnini kiriting" });

        const audit = await ManagementAudit.findById(req.params.id);
        if (!audit) return res.status(404).json({ message: "Audit xulosasi topilmadi" });

        if (!audit.comments) audit.comments = [];
        audit.comments.push({
            userId: req.user.userId,
            username: req.user.username,
            userRole: req.user.role,
            text: text.trim(),
            createdAt: new Date(),
            updatedAt: new Date()
        });

        await audit.save();
        res.json(audit);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 9. Edit Comment on Audit Note (Admin can edit ANY comment, or Comment Author)
app.put('/api/management/audits/:id/comment/:commentId', authMiddleware, async (req, res) => {
    try {
        const { text } = req.body;
        if (!text || !text.trim()) return res.status(400).json({ message: "Izoh matnini kiriting" });

        const audit = await ManagementAudit.findById(req.params.id);
        if (!audit) return res.status(404).json({ message: "Audit xulosasi topilmadi" });

        const comment = audit.comments.id(req.params.commentId);
        if (!comment) return res.status(404).json({ message: "Izoh topilmadi" });

        if (req.user.role !== 'admin' && comment.userId?.toString() !== req.user.userId) {
            return res.status(403).json({ message: "Faqat admin yoki izoh muallifi tahrirlashi mumkin" });
        }

        comment.text = text.trim();
        comment.updatedAt = new Date();
        await audit.save();
        res.json(audit);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

// 10. Delete Comment on Audit Note (Admin can delete ANY comment, or Comment Author)
app.delete('/api/management/audits/:id/comment/:commentId', authMiddleware, async (req, res) => {
    try {
        const audit = await ManagementAudit.findById(req.params.id);
        if (!audit) return res.status(404).json({ message: "Audit xulosasi topilmadi" });

        const comment = audit.comments.id(req.params.commentId);
        if (!comment) return res.status(404).json({ message: "Izoh topilmadi" });

        if (req.user.role !== 'admin' && comment.userId?.toString() !== req.user.userId) {
            return res.status(403).json({ message: "Faqat admin yoki izoh muallifi o'chirishi mumkin" });
        }

        audit.comments.pull(req.params.commentId);
        await audit.save();
        res.json(audit);
    } catch (err) {
        res.status(500).json({ message: err.message });
    }
});

